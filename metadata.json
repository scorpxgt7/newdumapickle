ter md:text-left\"\u003e\n                \u003cdiv\u003e\n                    \u003cdiv class\u003d\"flex items-center gap-2 justify-center md:justify-start mb-4\"\u003e\n                        \u003cdiv class\u003d\"w-6 h-6 rounded-full bg-gray-900 flex items-center justify-center text-white font-bold text-sm\"\u003e\n                            D\n                        \u003c/div\u003e\n                        \u003cspan class\u003d\"font-bold text-lg text-gray-900\"\u003eDumaPickle Finds\u003c/span\u003e\n                    \u003c/div\u003e\n                    \u003cp class\u003d\"text-sm text-gray-500 leading-relaxed max-w-xs mx-auto md:mx-0\"\u003e\n                        Curating the best pickleball gear available online. We help you find quality equipment to elevate your game.\n                    \u003c/p\u003e\n                \u003c/div\u003e\n                \u003cdiv\u003e\n                    \u003ch3 class\u003d\"text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4\"\u003eDisclosure\u003c/h3\u003e\n                    \u003cp class\u003d\"text-sm text-gray-500 leading-relaxed max-w-xs mx-auto md:mx-0\"\u003e\n                        As a Lazada Affiliate, we may earn a small commission from qualifying purchases made through links on this page at no extra cost to you.\n                    \u003c/p\u003e\n                \u003c/div\u003e\n                \u003cdiv\u003e\n                    \u003ch3 class\u003d\"text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4\"\u003eQuick Links\u003c/h3\u003e\n                    \u003cul class\u003d\"space-y-2 text-sm text-gray-500\"\u003e\n                        \u003cli\u003e\u003ca href\u003d\"#\" class\u003d\"hover:text-brand-600 transition-colors\"\u003eHome\u003c/a\u003e\u003c/li\u003e\n                        \u003cli\u003e\u003ca href\u003d\"#featured\" class\u003d\"hover:text-brand-600 transition-colors\"\u003eShop\u003c/a\u003e\u003c/li\u003e\n                        \u003cli\u003e\u003ca href\u003d\"#\" class\u003d\"hover:text-brand-600 transition-colors\"\u003eContact\u003c/a\u003e\u003c/li\u003e\n                    \u003c/ul\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003cdiv class\u003d\"border-t border-gray-100 mt-12 pt-8 text-center\"\u003e\n                \u003cp class\u003d\"text-xs text-gray-400\"\u003e\u0026copy; 2026 DumaPickle Reviews. All rights reserved.\u003c/p\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/footer\u003e\n\n    \u003c!-- AI Chat Widget UI --\u003e\n    \u003cdiv id\u003d\"ai-chat-widget\" class\u003d\"fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-none\"\u003e\n        \u003c!-- Chat Window --\u003e\n        \u003cdiv id\u003d\"ai-chat-window\" class\u003d\"bg-white border border-gray-200 shadow-2xl rounded-2xl w-80 sm:w-96 h-[30rem] max-h-[80vh] flex flex-col overflow-hidden mb-4 opacity-0 scale-95 origin-bottom-right transition-all duration-300 pointer-events-none hidden\"\u003e\n            \u003c!-- Header --\u003e\n            \u003cdiv class\u003d\"bg-brand-600 text-white p-4 flex justify-between items-center shadow-md z-10\"\u003e\n                \u003cdiv class\u003d\"flex items-center gap-3\"\u003e\n                    \u003cdiv class\u003d\"w-8 h-8 rounded-full bg-white/20 flex items-center justify-center font-bold text-sm\"\u003eAI\u003c/div\u003e\n                    \u003cdiv\u003e\n                        \u003ch3 class\u003d\"font-semibold text-sm\"\u003eDuma Coach\u003c/h3\u003e\n                        \u003cp class\u003d\"text-[10px] text-brand-100\"\u003eAsk about gear \u0026 tips\u003c/p\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n                \u003cbutton id\u003d\"close-chat-btn\" class\u003d\"text-white hover:text-brand-200 transition-colors focus:outline-none\"\u003e\n                    \u003csvg class\u003d\"w-5 h-5\" fill\u003d\"none\" stroke\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\" stroke-width\u003d\"2\" d\u003d\"M6 18L18 6M6 6l12 12\"\u003e\u003c/path\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n            \u003c/div\u003e\n            \n            \u003c!-- Messages Area --\u003e\n            \u003cdiv id\u003d\"chat-messages\" class\u003d\"flex-grow p-4 overflow-y-auto bg-gray-50 flex flex-col gap-3 text-sm\"\u003e\n                \u003c!-- Welcome Message --\u003e\n                \u003cdiv class\u003d\"self-start bg-white border border-gray-100 p-3 rounded-2xl rounded-tl-none shadow-sm max-w-[85%]\"\u003e\n                    Hi! 👋 I\u0027m your Duma Pickleball AI Assistant. Looking for paddle recommendations or tips to improve your game?\n                \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003c!-- Input Area --\u003e\n            \u003cdiv class\u003d\"p-3 bg-white border-t border-gray-100\"\u003e\n                \u003cform id\u003d\"chat-form\" class\u003d\"flex gap-2 relative\"\u003e\n                    \u003cinput type\u003d\"text\" id\u003d\"chat-input\" class\u003d\"w-full bg-gray-50 border border-gray-200 text-gray-900 rounded-full pl-4 pr-12 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all\" placeholder\u003d\"Ask a question...\" autocomplete\u003d\"off\"\u003e\n                    \u003cbutton type\u003d\"submit\" id\u003d\"send-btn\" class\u003d\"absolute right-1 top-1 bottom-1 bg-brand-600 hover:bg-brand-700 text-white rounded-full w-8 flex items-center justify-center transition-colors shadow-sm focus:outline-none disabled:opacity-50\"\u003e\n                        \u003csvg class\u003d\"w-4 h-4 ml-0.5\" fill\u003d\"none\" stroke\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\" stroke-width\u003d\"2\" d\u003d\"M12 19l9 2-9-18-9 18 9-2zm0 0v-8\"\u003e\u003c/path\u003e\u003c/svg\u003e\n                    \u003c/button\u003e\n                \u003c/form\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003c!-- Toggle Button --\u003e\n        \u003cbutton id\u003d\"toggle-chat-btn\" class\u003d\"bg-brand-600 hover:bg-brand-700 text-white rounded-full w-14 h-14 shadow-lg shadow-brand-500/40 flex items-center justify-center transition-transform hover:scale-105 focus:outline-none pointer-events-auto\"\u003e\n            \u003csvg class\u003d\"w-6 h-6\" fill\u003d\"none\" stroke\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\" stroke-width\u003d\"2\" d\u003d\"M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z\"\u003e\u003c/path\u003e\u003c/svg\u003e\n        \u003c/button\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Application Logic --\u003e\n    \u003cscript\u003e\n        // Curated, diverse list of 12 items from the provided dataset\n        const productsData \u003d [\n            {\n                name: \"Laser Pickleball Paddle Edge Protection Tape (Curved Fit)\",\n                originalPrice: 193.73,\n                price: 113.96,\n                discount: \"-41%\",\n                image: \"https://sg-test-11.slatic.net/p/19d59be682c1f6c4243bb07979032ffb.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67RyD?c\u003dd\u0026t\u003dp-iGxgo8a-s2LX7hDl\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Waterproof Universal Neoprene Protective Sleeve Cover\",\n                originalPrice: 215.93,\n                price: 127.02,\n                discount: \"-41%\",\n                image: \"https://sg-test-11.slatic.net/p/d364d198cfb164e1d3a08710dc2e7c64.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67Ryx?c\u003dc\u0026t\u003dp-iGyJrRN-s2La892a\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Beesoul Thermal Press Carbon Fiber T800 Match Paddle\",\n                originalPrice: 20384.76,\n                price: 20384.76,\n                discount: \"\",\n                image: \"https://filebroker-cdn.lazada.com.ph/kf/Scadd971aeab2486f939b5d734c17111dF.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67RBZ?c\u003dc\u0026t\u003dp-i5rsdvK-sZ8cdhc\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Dirt Remover Pickleball Paddle Eraser \u0026 Cleaner\",\n                originalPrice: 233.00,\n                price: 125.96,\n                discount: \"-46%\",\n                image: \"https://sg-test-11.slatic.net/p/c4d70065d2ce8d71f4c29efdf16fc49b.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67RAY?c\u003dc\u0026t\u003dp-iGxYyXK-s2LWf3fS\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Silicone Pickleball Paddle Handle Protective Grip Cover\",\n                originalPrice: 356.00,\n                price: 118.00,\n                discount: \"-67%\",\n                image: \"https://sg-test-11.slatic.net/p/db5161b1abad6fbff42efec80667d5c3.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67RAe?c\u003dc\u0026t\u003dp-i5eC7Aw-sXUO3pS\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Joola Professional Carbon Fiber USAPA Approved Paddle\",\n                originalPrice: 8183.00,\n                price: 8183.00,\n                discount: \"\",\n                image: \"https://filebroker-cdn.lazada.com.ph/kf/S6dc7cad1c26d4a72b7c2c444cc6082863.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67RBD?c\u003dd\u0026t\u003dp-iGwbCsJ-s2LRfjt7\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"10Pcs Self Adhesive Weighted Lead Tape for Custom Balance\",\n                originalPrice: 224.24,\n                price: 124.58,\n                discount: \"-44%\",\n                image: \"https://sg-test-11.slatic.net/p/a35c03d4772affe78442906788b85098.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z67RyB?c\u003dd\u0026t\u003dp-iGxsQG5-s2LXEvwz\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Flameer Silicone Suction Cup Ball Retriever Accessory\",\n                originalPrice: 219.00,\n                price: 121.83,\n                discount: \"-44%\",\n                image: \"https://sg-test-11.slatic.net/p/6edefc70d28ae1ce44cb87ff8955fcbe.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z678ZK?c\u003dd\u0026t\u003dp-i5MThVF-sVFk3tZ\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Wall Mounted Racket \u0026 Ball Holder Storage Rack\",\n                originalPrice: 212.33,\n                price: 124.90,\n                discount: \"-41%\",\n                image: \"https://sg-test-11.slatic.net/p/6085d39d6e0d92c3a9da91ee3a67e36e.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z6781R?c\u003dc\u0026t\u003dp-iGyaFwV-s2LaM0vb\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Joola Professional Carbon Fiber Paddle 5th Generation\",\n                originalPrice: 26176.00,\n                price: 26176.00,\n                discount: \"\",\n                image: \"https://filebroker-cdn.lazada.com.ph/kf/S7ef469f49fb04aa7aad4170c69bc7ad76.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z678aE?c\u003dc\u0026t\u003dp-iGukGZY-s2LM9Epy\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"JOOLA Scorpeus Pro V Anna Bright Edition Paddle\",\n                originalPrice: 18575.00,\n                price: 18575.00,\n                discount: \"\",\n                image: \"https://sg-test-11.slatic.net/p/84f1f6170e91af65a28db63b030fedc4.png\",\n                link: \"https://s.lazada.com.ph/s.Z678ZA?c\u003dc\u0026t\u003dp-iGrNykK-s2L7pcHj\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            },\n            {\n                name: \"Dopamine Fitness Series Detachable Paddle Keychain Charm\",\n                originalPrice: 185.00,\n                price: 109.00,\n                discount: \"-41%\",\n                image: \"https://sg-test-11.slatic.net/p/b7fc7e40477a44290b0eed3105713391.jpg\",\n                link: \"https://s.lazada.com.ph/s.Z678Zl?c\u003dd\u0026t\u003dp-iGySgox-s2LasGbn\u0026sub_aff_id\u003dDumapickleReview\u0026linkFormat\u003d1\"\n            }\n        ];\n\n        // Format number as PHP Currency\n        const formatPrice \u003d (price) \u003d\u003e {\n            return new Intl.NumberFormat(\u0027en-PH\u0027, { \n                style: \u0027currency\u0027, \n                currency: \u0027PHP\u0027,\n                minimumFractionDigits: 2\n            }).format(price);\n        };\n\n        // Render products to the grid\n        const renderProducts \u003d () \u003d\u003e {\n            const grid \u003d document.getElementById(\u0027product-grid\u0027);\n            grid.innerHTML \u003d \u0027\u0027;\n\n            productsData.forEach(product \u003d\u003e {\n                // Determine if there is a real discount to show\n                const hasDiscount \u003d product.discount \u0026\u0026 product.discount !\u003d\u003d \"0%\" \u0026\u0026 product.price \u003c product.originalPrice;\n                \n                const card \u003d document.createElement(\u0027div\u0027);\n                card.className \u003d \"bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:border-gray-200 transition-all duration-300 flex flex-col group overflow-hidden\";\n                \n                card.innerHTML \u003d `\n                    \u003cdiv class\u003d\"relative w-full aspect-[4/3] bg-gray-100 overflow-hidden cursor-pointer\" onclick\u003d\"window.open(\u0027${product.link}\u0027, \u0027_blank\u0027)\"\u003e\n                        \u003cimg src\u003d\"${product.image}\" alt\u003d\"${product.name}\" class\u003d\"w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500\" loading\u003d\"lazy\" onerror\u003d\"this.src\u003d\u0027https://placehold.co/400x300/f3f4f6/a1a1aa?text\u003dImage+Unavailable\u0027\"\u003e\n                        ${hasDiscount ? `\u003cdiv class\u003d\"absolute top-3 right-3 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-md shadow-sm\"\u003e${product.discount}\u003c/div\u003e` : \u0027\u0027}\n                    \u003c/div\u003e\n                    \n                    \u003cdiv class\u003d\"p-5 flex flex-col flex-grow\"\u003e\n                        \u003ca href\u003d\"${product.link}\" target\u003d\"_blank\" class\u003d\"block mb-2 group-hover:text-brand-600 transition-colors\"\u003e\n                            \u003ch3 class\u003d\"font-semibold text-gray-900 leading-snug line-clamp-2\" title\u003d\"${product.name}\"\u003e${product.name}\u003c/h3\u003e\n                        \u003c/a\u003e\n                        \n                        \u003cdiv class\u003d\"mt-auto pt-4 flex flex-col gap-4\"\u003e\n                            \u003cdiv class\u003d\"flex items-baseline gap-2 flex-wrap\"\u003e\n                                \u003cspan class\u003d\"text-xl font-bold text-lazada\"\u003e${formatPrice(product.price)}\u003c/span\u003e\n                                ${hasDiscount ? `\u003cspan class\u003d\"text-sm text-gray-400 line-through\"\u003e${formatPrice(product.originalPrice)}\u003c/span\u003e` : \u0027\u0027}\n                            \u003c/div\u003e\n                            \n                            \u003ca href\u003d\"${product.link}\" target\u003d\"_blank\" rel\u003d\"noopener noreferrer\" class\u003d\"w-full bg-white border-2 border-brand-600 text-brand-600 hover:bg-brand-600 hover:text-white font-semibold py-2.5 px-4 rounded-xl transition-colors duration-200 text-center flex items-center justify-center gap-2\"\u003e\n                                \u003cspan\u003eShop on Lazada\u003c/span\u003e\n                                \u003csvg class\u003d\"w-4 h-4\" fill\u003d\"none\" stroke\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath stroke-linecap\u003d\"round\" stroke-linejoin\u003d\"round\" stroke-width\u003d\"2\" d\u003d\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\"\u003e\u003c/path\u003e\u003c/svg\u003e\n                            \u003c/a\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                `;\n                \n                grid.appendChild(card);\n            });\n        };\n\n        // Initialize\n        document.addEventListener(\u0027DOMContentLoaded\u0027, renderProducts);\n\n        \n        // Chat UI Elements\n        const toggleChatBtn \u003d document.getElementById(\u0027toggle-chat-btn\u0027);\n        const closeChatBtn \u003d document.getElementById(\u0027close-chat-btn\u0027);\n        const chatWindow \u003d document.getElementById(\u0027ai-chat-window\u0027);\n        const chatForm \u003d document.getElementById(\u0027chat-form\u0027);\n        const chatInput \u003d document.getElementById(\u0027chat-input\u0027);\n        const chatMessages \u003d document.getElementById(\u0027chat-messages\u0027);\n        const sendBtn \u003d document.getElementById(\u0027send-btn\u0027);\n\n        let isChatOpen \u003d false;\n        let aiChatHistory \u003d [];\n\n        // Toggle Chat Window\n        const toggleChat \u003d () \u003d\u003e {\n            isChatOpen \u003d !isChatOpen;\n            if (isChatOpen) {\n                chatWindow.classList.remove(\u0027hidden\u0027);\n                chatWindow.classList.add(\u0027pointer-events-auto\u0027);\n                // Small delay to allow display:block to apply before animating opacity\n                setTimeout(() \u003d\u003e {\n                    chatWindow.classList.remove(\u0027opacity-0\u0027, \u0027scale-95\u0027);\n                    chatWindow.classList.add(\u0027opacity-100\u0027, \u0027scale-100\u0027);\n                }, 10);\n                chatInput.focus();\n            } else {\n                chatWindow.classList.remove(\u0027opacity-100\u0027, \u0027scale-100\u0027);\n                chatWindow.classList.add(\u0027opacity-0\u0027, \u0027scale-95\u0027);\n                chatWindow.classList.remove(\u0027pointer-events-auto\u0027);\n                setTimeout(() \u003d\u003e {\n                    chatWindow.classList.add(\u0027hidden\u0027);\n                }, 300);\n            }\n        };\n\n        toggleChatBtn.addEventListener(\u0027click\u0027, toggleChat);\n        closeChatBtn.addEventListener(\u0027click\u0027, toggleChat);\n\n\n        // Helper to add a message to the UI\n        const appendMessage \u003d (text, sender) \u003d\u003e {\n            const msgDiv \u003d document.createElement(\u0027div\u0027);\n            \n            // Format bold text (**text**) and links loosely generated by AI\n            const formattedText \u003d text\n                .replace(/\\*\\*(.*?)\\*\\*/g, \u0027\u003cstrong\u003e$1\u003c/strong\u003e\u0027)\n                .replace(/(https?:\\/\\/[^\\s]+)/g, \u0027\u003ca href\u003d\"$1\" target\u003d\"_blank\" class\u003d\"text-brand-600 underline break-words\"\u003e$1\u003c/a\u003e\u0027);\n\n            if (sender \u003d\u003d\u003d \u0027user\u0027) {\n                msgDiv.className \u003d \"self-end bg-brand-600 text-white p-3 rounded-2xl rounded-tr-none shadow-sm max-w-[85%]\";\n                msgDiv.textContent \u003d text; // User input kept raw for safety\n            } else if (sender \u003d\u003d\u003d \u0027ai\u0027) {\n                msgDiv.className \u003d \"self-start bg-white border border-gray-100 p-3 rounded-2xl rounded-tl-none shadow-sm max-w-[85%]\";\n                msgDiv.innerHTML \u003d formattedText;\n            } else if (sender \u003d\u003d\u003d \u0027loading\u0027) {\n                msgDiv.id \u003d \"loading-indicator\";\n                msgDiv.className \u003d \"self-start bg-gray-100 p-3 rounded-2xl rounded-tl-none shadow-sm max-w-[85%] flex gap-1 items-center\";\n                msgDiv.innerHTML \u003d `\u003cdiv class\u003d\"w-2 h-2 bg-gray-400 rounded-full animate-bounce\"\u003e\u003c/div\u003e\u003cdiv class\u003d\"w-2 h-2 bg-gray-400 rounded-full animate-bounce\" style\u003d\"animation-delay: 0.1s\"\u003e\u003c/div\u003e\u003cdiv class\u003d\"w-2 h-2 bg-gray-400 rounded-full animate-bounce\" style\u003d\"animation-delay: 0.2s\"\u003e\u003c/div\u003e`;\n            }\n\n            chatMessages.appendChild(msgDiv);\n            chatMessages.scrollTop \u003d chatMessages.scrollHeight;\n        };\n\n        const removeLoadingIndicator \u003d () \u003d\u003e {\n            const loader \u003d document.getElementById(\u0027loading-indicator\u0027);\n            if (loader) loader.remove();\n        };\n\n\n        // Construct dynamic system prompt with current affiliate products\n        const getSystemPrompt \u003d () \u003d\u003e {\n            let catalogString \u003d productsData.map(p \u003d\u003e \n                `- Product: ${p.name}\\n  Price: PHP ${p.price}\\n  Affiliate Link: ${p.link}`\n            ).join(\u0027\\n\\n\u0027);\n\n            return `You are Duma, a friendly, expert Pickleball coach and shopping assistant for the site \u0027Duma Pickleball Finds\u0027.\n            Your primary goal is to provide helpful pickleball advice and strategically recommend products from our specific catalog.\n            Always keep your answers concise, conversational, and format them nicely.\n            \n            OUR PRODUCT CATALOG (Always recommend these specific links if relevant):\n            ${catalogString}\n            \n            Rules:\n            1. If a user asks for a recommendation, pick 1 or 2 products from the catalog above and provide the exact Affiliate Link.\n            2. Be enthusiastic about the sport.\n            3. Do not invent products not in the list.\n            4. Keep responses short (1-3 paragraphs max) as this is a small chat widget.`;\n        };\n\n        // Handle sending message to Gemini API\n        const callGeminiAPI \u003d async (userText) \u003d\u003e {\n            const apiKey \u003d \"\"; // API key injected by environment\n            const apiUrl \u003d `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key\u003d${apiKey}`;\n\n            // Add user message to history\n            aiChatHistory.push({ role: \"user\", parts: [{ text: userText }] });\n\n            const payload \u003d {\n                contents: aiChatHistory,\n                systemInstruction: {\n                    parts: [{ text: getSystemPrompt() }]\n                }\n            };\n\n            // Implement simple retry backoff\n            const fetchWithRetry \u003d async (url, options, retries \u003d 3, delay \u003d 1000) \u003d\u003e {\n                try {\n                    const res \u003d await fetch(url, options);\n                    if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);\n                    return await res.json();\n                } catch (error) {\n                    if (retries \u003e 0) {\n                        await new Promise(resolve \u003d\u003e setTimeout(resolve, delay));\n                        return fetchWithRetry(url, options, retries - 1, delay * 2);\n                    } else {\n                        throw error;\n                    }\n                }\n            };\n\n            try {\n                const result \u003d await fetchWithRetry(apiUrl, {\n                    method: \u0027POST\u0027,\n                    headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 },\n                    body: JSON.stringify(payload)\n                });\n\n                if (result.candidates \u0026\u0026 result.candidates.length \u003e 0) {\n                    const responseText \u003d result.candidates[0].content.parts[0].text;\n                    \n                    // Add AI response to history\n                    aiChatHistory.push({ role: \"model\", parts: [{ text: responseText }] });\n                    \n                    removeLoadingIndicator();\n                    appendMessage(responseText, \u0027ai\u0027);\n                } else {\n                    throw new Error(\"Invalid response format\");\n                }\n            } catch (error) {\n                removeLoadingIndicator();\n                appendMessage(\"Sorry, I\u0027m having trouble connecting right now. Please try again later.\", \u0027ai\u0027);\n                // Remove the last user message from history so they can try again\n                aiChatHistory.pop();\n            }\n        };\n\n        chatForm.addEventListener(\u0027submit\u0027, async (e) \u003d\u003e {\n            e.preventDefault();\n            const text \u003d chatInput.value.trim();\n            if (!text) return;\n\n            // Update UI\n            chatInput.value \u003d \u0027\u0027;\n            chatInput.disabled \u003d true;\n            sendBtn.disabled \u003d true;\n            \n            appendMessage(text, \u0027user\u0027);\n            appendMessage(\u0027\u0027, \u0027loading\u0027);\n\n            // Call API\n            await callGeminiAPI(text);\n\n            // Restore UI\n            chatInput.disabled \u003d false;\n            sendBtn.disabled \u003d false;\n            chatInput.focus();\n        });\n\n    \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e",
  "requestFramePermissions": [
    "camera"
  ],
  "majorCapabilities": [
    "MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API"
  ]
}